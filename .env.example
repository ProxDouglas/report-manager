APP_NAME=Plataforma de Relatórios
APP_ENV=local
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://report_manager:report_manager@localhost:15432/report_manager
POSTGRES_HOST_PORT=15432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

SECRET_KEY=local-development-only-change-me
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=report_manager_session
SESSION_TTL_HOURS=12
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
ALLOW_BOOTSTRAP=true
BOOTSTRAP_OPERATOR_EMAIL=operator@example.com
BOOTSTRAP_OPERATOR_PASSWORD=change-this-local-password

RETENTION_REPORT_VERSIONS_YEARS=3
RETENTION_ARTIFACTS_YEARS=3
RETENTION_SOURCE_SNAPSHOTS_YEARS=3
RETENTION_EXECUTION_LOGS_YEARS=3
RETENTION_AUDIT_LOGS_YEARS=3

EXECUTION_TIMEOUT_SECONDS=1800
EXECUTION_MAX_ROWS=1000000
EXECUTION_MAX_RESULT_BYTES=524288000
SOURCE_MAX_FILE_BYTES=104857600
ARTIFACT_MAX_BYTES=524288000
ARTIFACT_STORAGE_BACKEND=postgres
SOURCE_CONNECTION_TIMEOUT_SECONDS=30
SOURCE_MAX_JSON_DEPTH=20
SOURCE_MAX_COLUMNS=500
SOURCE_MAX_SHEET_ROWS=1000000
PUBLIC_SOURCE_IPS_ONLY=true
MAX_USERS_PER_ORGANIZATION=50
MAX_CONCURRENT_EXECUTIONS_PER_ORGANIZATION=2
DISTRIBUTION_MAX_RETRIES=3
WEBHOOK_TIMEOUT_SECONDS=30
WORKER_READINESS_TIMEOUT_SECONDS=90
QUEUE_STALL_SECONDS=900
ARTIFACT_STORAGE_WARNING_BYTES=4000000000
LICENSE_EXPIRATION_WARNING_DAYS=30

SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_MB=2048
SANDBOX_MAX_RETRIES=3
SANDBOX_NETWORK_MODE=none
SANDBOX_IMAGE=report-manager-sandbox:local
SANDBOX_READ_ONLY=true
SANDBOX_WORKSPACE=/tmp/report-manager-sandbox

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=report-manager
SMTP_PASSWORD_SECRET_REF=vault://platform/smtp/report-manager
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=reports@example.com
SMTP_FROM_NAME=Plataforma de Relatórios
SMTP_TIMEOUT_SECONDS=30

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token
